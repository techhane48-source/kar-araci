# Apache koruması (public_html kökü)
Options -Indexes

# includes/ ve data/ web kökünün dışında tutulur; yine de yanlış konumda kalırsa erişimi kapat
<FilesMatch "\.(sqlite|db|sql)$">
  Require all denied
</FilesMatch>

# Chrome eklentisi API anahtarı: Authorization başlığını PHP'ye geçir (bazı Apache/LiteSpeed kurulumları düşürür)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
